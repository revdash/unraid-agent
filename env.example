# Copy this file to .env and fill in your own values.
# .env is gitignored -- never commit your real values.

# Your Unraid server's LAN IP.
UNRAID_HOST=

# Path to the SSH private key for the dedicated agent user (see
# README.md "Setup" section for how to create this account).
# Use an absolute path, e.g. /root/.ssh/agent_key
SSH_KEY_PATH=

# Dedicated non-root SSH user for the agent. Do not use root.
UNRAID_USER=ai-agent

# Where your Ollama instance is reachable from this container.
# Use the LAN IP (not a Docker hostname) since the agent runs with
# --network host.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# 1 = read-only, 2 = start/stop/restart, 3 = unrestricted (still
# confirms destructive commands). Start at 1.
AGENT_PHASE=1

# Only containers whose name starts with this prefix can be
# started/stopped/restarted by the agent, in any phase. Everything
# else on your server is permanently off-limits to it. Pick a prefix
# and name every container you want the agent to manage accordingly,
# e.g. "agent-myservice".
CONTAINER_SCOPE_PREFIX=agent-

# Port the locked-down Docker proxy listens on. Only change this if
# 2375 was already taken on your server when install.sh ran (it will
# tell you if so).
DOCKER_PROXY_PORT=2375
